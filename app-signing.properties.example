# Copy to app-signing.properties (git-ignored) and fill in — see docs/app-updates.md.
# The app signing key: signs the APK on Zealot, and later goes to Play App Signing. Keep the .jks outside the
# repo; storeFile is absolute or relative to the Android project folder.
storeFile=/Users/you/keys/inilauncher-release.jks
storePassword=change-me
keyAlias=inilauncher
keyPassword=change-me
