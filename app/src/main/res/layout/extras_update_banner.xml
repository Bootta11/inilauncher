<?xml version="1.0" encoding="utf-8"?>
<!-- Inilauncher: "Version X is available" card at the bottom of every screen (direct build only).
     The plain rounded card, not bg_dialog: that one is inset 20dp, which pushed the text onto its edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updateBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="72dp"
    android:background="@drawable/rounded_rectangle_dark"
    android:clickable="true"
    android:focusable="true"
    android:maxWidth="560dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/updateTitle"
        style="@style/TextSmallBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/updateMessage"
        style="@style/TextSmallLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/updateProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateLater"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/update_later" />

        <TextView
            android:id="@+id/updateAction"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/update_now" />
    </LinearLayout>
</LinearLayout>
