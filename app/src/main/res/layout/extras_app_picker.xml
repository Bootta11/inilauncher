<?xml version="1.0" encoding="utf-8"?>
<!-- Inilauncher: full-screen app picker (extras/picker/AppPickerScreen): title, search, apps with icons, A–Z strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pickerScrimColor"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/pickerTitle"
            style="@style/TextLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/pickerClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <EditText
        android:id="@+id/pickerSearch"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/rounded_rect_shade_color"
        android:hint="@string/app_picker_search"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="text|textNoSuggestions"
        android:maxLength="60"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:singleLine="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pickerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:requiresFadingEdge="vertical" />

        <TextView
            android:id="@+id/pickerEmpty"
            style="@style/ExtrasRowHint"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/app_picker_no_match"
            android:visibility="gone" />

        <app.olauncher.extras.search.AlphabetScrollerView
            android:id="@+id/pickerScroller"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginBottom="24dp" />
    </FrameLayout>

    <!-- Done (choose many) or Nothing (choose one) -->
    <TextView
        android:id="@+id/pickerAction"
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:minHeight="48dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:visibility="gone" />
</LinearLayout>
