<?xml version="1.0" encoding="utf-8"?>
<!-- Inilauncher: gesture animations (app list after a swipe up) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/dialog_anim_duration"
    android:interpolator="@interpolator/motion_easing"
    android:shareInterpolator="true">
    <translate
        android:fromXDelta="0%"
        android:fromYDelta="8%"
        android:toXDelta="0%"
        android:toYDelta="0%" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
