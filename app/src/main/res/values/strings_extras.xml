    <!-- Search & app list -->
    <string name="search_contacts">Contacts</string>
    <string name="search_contacts_hint">Shows matching contacts when you search. Needs contacts access; nothing leaves your phone.</string>
    <string name="search_contacts_need">Contact search needs contacts access</string>
    <string name="search_calculator">Calculator</string>
    <string name="search_calculator_hint">Type a sum like 12*3+4 to see the answer. Tap it or press Enter to copy it. While you type a sum, the app list doesn\'t open an app by itself.</string>
    <string name="search_hold_toggle">Auto-open switch in search bar</string>
    <string name="search_hold_toggle_hint">Shows an auto-open switch next to the app search. Tap it to find an app without it opening by itself, for example to check its app info or uninstall it. It switches back each time you open the app list. Starting a search with a space does the same without the switch.</string>
    <string name="search_hold_actions">Show actions for a single match</string>
    <string name="search_hold_actions_hint">In a search that doesn\'t open apps by itself (started with a space, or with the switch on Hold), shows the app\'s actions (uninstall, app info…) as soon as only one app is left.</string>
    <string name="hold_search_on">Auto</string>
    <string name="hold_search_off">Hold</string>
    <string name="hold_search_on_description">Auto-open on</string>
    <string name="hold_search_off_description">Auto-open paused</string>
    <string name="search_web">Web suggestions</string>
    <string name="search_web_hint">Shows search suggestions from DuckDuckGo. Everything you type in the search box is sent to DuckDuckGo while this is on.</string>
    <string name="search_shortcuts">App shortcuts</string>
    <string name="search_shortcuts_hint">Finds app shortcuts (like "New message") when you search. Works while Inilauncher is your default home app.</string>
